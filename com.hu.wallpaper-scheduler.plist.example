<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hu.wallpaper-scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/REPLACE/Library/Application Support/WallpaperScheduler/wallpaper_scheduler.py</string>
    <string>--config</string>
    <string>/Users/REPLACE/Library/Application Support/WallpaperScheduler/config.json</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/wallpaper-scheduler.out</string>
  <key>StandardErrorPath</key><string>/tmp/wallpaper-scheduler.err</string>
</dict>
</plist>
